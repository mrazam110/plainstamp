# Provider selection (core/llm/, core/embeddings/, ingest embedder)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
# 128-3072; index and queries must use the same value (current local index: fastembed MiniLM, 384)
EMBEDDING_DIMENSION=768
# Seconds to wait between 100-chunk batches when re-embedding (free-tier rate limits are not documented; raise on 429)
EMBEDDING_BATCH_DELAY=0
GEMINI_API_KEY=

# Retrieval backend: bundle | postgres | vectorize (decided in Phase 3)
RETRIEVER_BACKEND=postgres
DATABASE_URL=

# NVIDIA API catalog (optional, DEV AND EVAL ONLY, never for the public site). Off unless ALLOW_TRIAL_PROVIDERS=1.
# NVIDIA's trial terms allow testing and evaluation only (no production), may use inputs to improve NVIDIA products,
# and forbid personal data. Use: LLM_PROVIDER=nvidia, EMBEDDING_PROVIDER=nvidia (embeddings are 2048-d only, so a
# separate database or table; the Gemini index is 768-d and cannot be mixed).
# LLM_MODEL defaults to nvidia/nemotron-3-super-120b-a12b; deepseek-ai/deepseek-v4.1-flash hung on a trial key.
ALLOW_TRIAL_PROVIDERS=0
NVIDIA_API_KEY=
