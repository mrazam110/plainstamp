# Provider selection (core/llm/, core/embeddings/, ingest embedder)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
# 128-3072; index and queries must use the same value (current local index: fastembed MiniLM, 384)
EMBEDDING_DIMENSION=768
# Seconds to wait between 100-chunk batches when re-embedding (free-tier rate limits are not documented; raise on 429)
EMBEDDING_BATCH_DELAY=0
GEMINI_API_KEY=

# Retrieval backend: bundle | postgres | vectorize (decided in Phase 3)
RETRIEVER_BACKEND=postgres
DATABASE_URL=
